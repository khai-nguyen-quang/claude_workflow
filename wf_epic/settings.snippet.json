{
  "_comment": "Merge into .claude/settings.json. Absolute paths required in hook commands.",

  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "WF_EPIC_ROOT": "/home/khainguyen/workspace"
  },

  "teammateMode": "tmux",
  "subagentPromptCacheTtl": "1h",

  "hooks": {
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/khainguyen/workspace/claude_workflow/wf_epic/hooks/task_completed.sh"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/khainguyen/workspace/claude_workflow/wf_epic/hooks/teammate_idle.sh"
          }
        ]
      }
    ]
  }
}
