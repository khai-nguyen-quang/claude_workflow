# Credentials for the forges this workflow drives.
# Configure only the one(s) you use -- tools/forge/resolve.sh tolerates the other
# being absent, so a GitHub-only setup needs no GL_* variables at all.

# --- GitLab ---
GL_USERNAME=khai.nguyen
GL_TOKEN=glpat-xxxxxxxxxxxx
GL_URL=https://gitlab.company.com
GL_NAMESPACE=group/subgroup

# --- GitHub ---
# Set GH_FINEGRAINED_TOKEN, GH_TOKEN, or both. When both are present the
# fine-grained one is used: its per-repository permissions are what this
# workflow documents, while a classic token's scopes are account-wide.
#
# A fine-grained token needs, on each repository it serves:
#   Issues: Read & write      (sub-issues live here)
#   Contents: Read & write
#   Pull requests: Read & write
#   Metadata: Read
# and, critically, that repository must be listed under "Repository access" --
# "Public repositories" alone cannot reach a private repo.
GH_USERNAME=your-github-login
GH_FINEGRAINED_TOKEN=github_pat_xxxxxxxxxxxx
GH_TOKEN=ghp_xxxxxxxxxxxx
