# Credentials for the forges this workflow drives.
# Configure only the one(s) you use -- tools/forge/resolve.sh tolerates the other
# being absent, so a GitHub-only setup needs no GL_* variables at all.

# --- GitLab ---
GL_USERNAME=khai.nguyen
GL_TOKEN=glpat-xxxxxxxxxxxx
GL_URL=https://gitlab.company.com
GL_NAMESPACE=group/subgroup

# --- GitHub ---
# A fine-grained personal access token needs, on each repository it serves:
#   Issues: Read & write      (sub-issues live here)
#   Contents: Read & write
#   Pull requests: Read & write
#   Metadata: Read
GH_USERNAME=your-github-login
GH_TOKEN=github_pat_xxxxxxxxxxxx
